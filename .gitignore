# ========================================
# Kickstarter Analytics Engineering
# Git Ignore Configuration
# ========================================

# Environments & Secrets
.env
.env.*
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Python Compilation & Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Jupyter Notebooks
.ipynb_checkpoints

# ========================================
# Power BI (Developer Mode / PBIP)
# ========================================
# Ignore standard monolithic binary files since we use PBIP
*.pbix
*.pbit

# Always track PBIP definitions and model files
!powerbi/**/*.json
!powerbi/**/*.tmdl
!powerbi/**/*.pbir
!powerbi/**/*.pbism
!powerbi/*.pbip

# Explicitly ignore local machine settings and cache
**/.pbi/localSettings.json
**/.pbi/editorSettings.json
**/.pbi/cache.abf
*.pbicache

# ========================================
# Large Raw Data Files - CRITICAL
# ========================================
# Never commit large data files or scraped archives to GitHub!
data/raw/
data/extracted/
data/**/*.csv
data/**/*.json
data/**/*.json.gz
data/**/*.zip
data/**/*.parquet

# Keep metadata manifests tracked
!data/metadata/*.csv

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Configurations
.idea/
*.swp
*.swo