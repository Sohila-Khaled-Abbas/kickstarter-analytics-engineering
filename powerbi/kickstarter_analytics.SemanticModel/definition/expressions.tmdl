		    Source =
		        Csv.Document(
		            File.Contents(
		                DataFolderPath & "raw\master_kickstarter\MasterKickstarter.csv"
		            ),
		            [
		                Delimiter = ",",
		                Columns = 57,
		                QuoteStyle = QuoteStyle.Csv
		            ]
		        ),
		
		    #"Promoted Headers" =
		        Table.PromoteHeaders(
		            Source,
		            [PromoteAllScalars = true]
