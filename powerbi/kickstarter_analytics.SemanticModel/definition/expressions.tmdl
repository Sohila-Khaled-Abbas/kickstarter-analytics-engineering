	annotation PBI_ResultType = Table

expression Stg_Master =
		let
		    // Kickstarter Stg_Master
		    // Source query: Src_Master
		    // Performance-optimized version: header-level renaming, early column reduction, and narrow duplicate-key validation.
		    // Removes invalid core records and preserves genuine optional source-data gaps as null.
		    // It does not fabricate locations, flags, timestamps, or financial amounts.
		
		    Source = Src_Master,
		
		    // The dataset's stated coverage reference; this is not an actual refresh timestamp.
		    SnapshotDateReference = #date(2017, 12, 31),
		    MinValidDateTime = #datetime(2009, 1, 1, 0, 0, 0),
		    MaxStartDateTime = #datetime(2017, 12, 31, 23, 59, 59),
		    MaxEndDateTime = #datetime(2018, 12, 31, 23, 59, 59),
		
		    // ------------------------------------------------------------------
		    // 1. Normalize headers and remove export/index artifacts.
		    // ------------------------------------------------------------------
		    CleanedHeaders = Table.TransformColumnNames(
		        Source,
		        each Text.Trim(Text.Clean(_))
		    ),
		
		    JunkColumnNames = {
		        "", "X1", "X1_1", "X1.1", "X", "X_1", "X.1",
		        "index", "_index", "row number", "row_number", "rownumber",
		        "row_num", "rownum", "row_id", "rowid", "unnamed: 0", "unnamed: 0.1"
		    },
		
		    JunkColumns = List.Select(
		        Table.ColumnNames(CleanedHeaders),
		        (ColumnName as text) as logical =>
		            let N = Text.Lower(Text.Trim(ColumnName))
		            in List.Contains(List.Transform(JunkColumnNames, each Text.Lower(_)), N)
		                or Text.StartsWith(N, "unnamed:")
		    ),
		
		    RemovedJunkColumns = Table.RemoveColumns(CleanedHeaders, JunkColumns, MissingField.Ignore),
		
		    // CanonicalMap was missing in the previous version, causing:
		    // "The import CanonicalMap matches no exports".
		    // Each item is {canonical output column, candidate source headers}.
		    // Candidate headers are checked in order; existing canonical columns are preserved.
		    CanonicalMap = {
		        {"ProjectID", {"id", "ID", "project_id", "ProjectID"}},
		        {"ProjectName", {"name", "Name", "ProjectName"}},
		        {"Blurb", {"blurb", "Blurb"}},
		        {"ProjectSlug", {"slug", "ProjectSlug"}},
		        {"ProjectStatus", {"status", "Status", "ProjectStatus"}},
		        {"StateName", {"State", "state_name", "region_state", "StateName"}},
		        {"Category", {"Categories", "main_category", "Main Category", "Category"}},
		        {"Subcategory", {"category", "subcategory", "sub_category", "Subcategory"}},
		        {"CountryName", {"Country", "country", "country_name", "CountryName"}},
		        {"CityName", {"City", "city", "city_name", "CityName"}},
		        {"CountyName", {"County", "county", "county_name", "CountyName"}},
		        {"CurrencyCode", {"currency", "Currency", "CurrencyCode"}},
		        {"CurrencySymbol", {"currency_symbol", "CurrencySymbol"}},
		        {"CurrencyTrailingCode", {"currency_trailing_code", "CurrencyTrailingCode"}},
		        {"GoalLocal", {"goal", "Goal", "GoalLocal"}},
		        {"PledgedLocal", {"pledged", "Pledged", "PledgedLocal"}},
		        {"GoalUSD", {"usd_goal_real", "usd goal real", "goal_usd", "GoalUSD"}},
		        {"PledgedUSD", {"pledgedUSD", "usd_pledged_real", "usd pledged", "usd_pledged", "pledged_usd", "PledgedUSD"}},
		        {"ExUSD", {"Ex_USd", "ex_usd", "EX_USD", "exUSD", "exchange_rate_usd", "static_usd_rate", "ExUSD"}},
		        {"BackerCount", {"backers_count", "backers", "Backers", "BackerCount"}},
		        {"StaffPickFlag", {"staff_pick", "staffPick", "StaffPickFlag"}},
		        {"SpotlightFlag", {"spotLight", "spotlight", "SpotlightFlag"}},
		        {"DisableCommunicationFlag", {"disable_communication", "DisableCommunicationFlag"}},
		        {"CreatedDateTime", {"created_at", "createdAt", "created", "CreatedDate", "CreatedDateTime"}},
		        {"LaunchDateTime", {"launched_at", "launched", "Launched", "LaunchDate", "LaunchDateTime"}},
		        {"DeadlineDateTime", {"deadline", "Deadline", "DeadlineDate", "DeadlineDateTime"}},
		        {"StateChangedDateTime", {"state_changed_at", "StateChangedDateTime"}},
		        {"Latitude", {"latitude", "Latitude"}},
		        {"Longitude", {"longitude", "Longitude"}},
		        {"CityPopulation", {"City_Pop", "city_pop", "CityPopulation"}},
		        {"DeadlineTime", {"deadlineTime", "DeadlineTime"}},
		        {"StateChangedTime", {"state_changed_atTime", "StateChangedTime"}},
		        {"CreatedTime", {"created_atTime", "CreatedTime"}},
		        {"LaunchTime", {"launched_atTime", "LaunchTime"}},
		        {"DeadlineYearMonth", {"deadlineYM", "DeadlineYearMonth"}},
		        {"StateChangedYearMonth", {"state_changed_atYM", "StateChangedYearMonth"}},
		        {"CreatedYearMonth", {"created_atYM", "CreatedYearMonth"}},
		        {"LaunchYearMonth", {"launched_atYM", "LaunchYearMonth"}},
		        {"DeadlineYear", {"deadlineY", "DeadlineYear"}},
		        {"StateChangedYear", {"state_changed_atY", "StateChangedYear"}},
		        {"CreatedYear", {"created_atY", "CreatedYear"}},
		        {"LaunchYear", {"launched_atY", "LaunchYear"}},
		        {"SourcePledgePerPerson", {"Pledge_per_person", "SourcePledgePerPerson"}},
		        {"SourceGoalAchievementPct", {"Prct_goal", "SourceGoalAchievementPct"}},
		        {"SourceCampaignLengthDays", {"Length_of_kick", "SourceCampaignLengthDays"}},
		        {"BackersPctOfPopulation", {"Backers_as_Prct_of_Pop", "BackersPctOfPopulation"}},
		        {"BackersPctOfPopulationYearMonth", {"Backers_as_Prct_of_Pop_YM", "BackersPctOfPopulationYearMonth"}},
		        {"BackersPctOfPopulationYear", {"Backers_as_Prct_of_Pop_Y", "BackersPctOfPopulationYear"}},
		        {"DaysSpentMakingCampaign", {"Days_spent_making_campign", "DaysSpentMakingCampaign"}},
		        {"DaysInceptionToDeadline", {"Days_inception_to_Deadline", "DaysInceptionToDeadline"}},
		        {"BackersInCityYear", {"Backers_in_city_Y", "BackersInCityYear"}},
		        {"BackersInCityYearMonth", {"Backers_in_city_YM", "BackersInCityYearMonth"}},
		        {"AllTimeBackersInCity", {"All_Time_Backers_city", "AllTimeBackersInCity"}},
		        {"MeanPledgeCity", {"Mean_Pledge_City", "MeanPledgeCity"}},
		        {"MeanPledgeCityYear", {"Mean_pledge_city_Y", "MeanPledgeCityYear"}},
		        {"MeanPledgeCityYearMonth", {"Mean_pledge_city_YM", "MeanPledgeCityYearMonth"}}
		    },
		
		    // ------------------------------------------------------------------
		    // 2. Canonicalize source fields.
		    // Exact header matching keeps fields such as "Category" and "category"
		    // distinct when the source uses them for different meanings.
		    // ------------------------------------------------------------------
		    // Rename aliases at the column-header level instead of adding a calculated
		    // column for every field. This is substantially faster on large CSV sources.
		    Canonicalized = List.Accumulate(
		        CanonicalMap,
		        RemovedJunkColumns,
		        (CurrentTable as table, Definition as list) as table =>
		            let
		                TargetName = Definition{0},
		                Aliases = Definition{1},
		                ExistingNames = Table.ColumnNames(CurrentTable),
		                AliasToUse = List.First(
		                    List.Select(Aliases, (Alias as text) as logical => List.Contains(ExistingNames, Alias)),
		                    null
		                )
		            in
		                if List.Contains(ExistingNames, TargetName) then CurrentTable
		                else if AliasToUse <> null then
		                    Table.RenameColumns(CurrentTable, {{AliasToUse, TargetName}}, MissingField.Ignore)
		                else CurrentTable
		    ),
		
		    // Keep only columns used by this staging query before expensive row-level
		    // cleaning. Missing expected columns are added immediately below.
		    ReducedSourceColumns = Table.SelectColumns(
		        Canonicalized,
		        List.Transform(CanonicalMap, each _{0}),
		        MissingField.UseNull
		    ),
		
		    // Ensure a stable schema even if an optional source field is absent.
		    RequiredSchema = {
		        {"ProjectID", type any}, {"ProjectName", type any}, {"Blurb", type any},
		        {"ProjectSlug", type any}, {"ProjectStatus", type any}, {"StateName", type any},
		        {"Category", type any}, {"Subcategory", type any}, {"CountryName", type any},
		        {"CityName", type any}, {"CountyName", type any}, {"CurrencyCode", type any},
		        {"CurrencySymbol", type any}, {"CurrencyTrailingCode", type any},
		        {"GoalLocal", type any}, {"PledgedLocal", type any}, {"GoalUSD", type any},
		        {"PledgedUSD", type any}, {"ExUSD", type any}, {"BackerCount", type any},
		        {"StaffPickFlag", type any}, {"SpotlightFlag", type any}, {"DisableCommunicationFlag", type any},
		        {"CreatedDateTime", type any}, {"LaunchDateTime", type any}, {"DeadlineDateTime", type any},
		        {"StateChangedDateTime", type any}, {"Latitude", type any}, {"Longitude", type any},
		        {"CityPopulation", type any}, {"SourcePledgePerPerson", type any},
		        {"SourceGoalAchievementPct", type any}, {"SourceCampaignLengthDays", type any},
		        {"BackersPctOfPopulation", type any}, {"BackersPctOfPopulationYearMonth", type any},
		        {"BackersPctOfPopulationYear", type any}, {"DaysSpentMakingCampaign", type any},
		        {"DaysInceptionToDeadline", type any}, {"BackersInCityYear", type any},
		        {"BackersInCityYearMonth", type any}, {"AllTimeBackersInCity", type any},
		        {"MeanPledgeCity", type any}, {"MeanPledgeCityYear", type any}, {"MeanPledgeCityYearMonth", type any}
		    },
		
		    WithRequiredColumns = List.Accumulate(
		        RequiredSchema,
		        ReducedSourceColumns,
		        (T as table, Definition as list) as table =>
		            if Table.HasColumns(T, Definition{0}) then T
		            else Table.AddColumn(T, Definition{0}, each null, Definition{1})
		    ),
		
		    // ------------------------------------------------------------------
		    // 3. Defensive cleaning functions.
		    // ------------------------------------------------------------------
		    CleanText = (InputValue as any) as nullable text =>
		        let
		            T = if InputValue = null then null else (try Text.Trim(Text.Clean(Text.From(InputValue, "en-US"))) otherwise null),
		            U = if T = null then null else Text.Upper(T)
		        in
		            if T = null or T = "" or List.Contains({"NA", "N/A", "NULL", "<NULL>", "NAN", "NAT"}, U)
		            then null else T,
		
		    CleanNumber = (InputValue as any) as nullable number =>
		        if InputValue = null then null
		        else if Value.Is(InputValue, type number) then (try Number.From(InputValue) otherwise null)
		        else
		            let
		                T = CleanText(InputValue),
		                IsAccountingNegative = T <> null and Text.StartsWith(T, "(") and Text.EndsWith(T, ")"),
		                Unwrapped = if T = null then null else if IsAccountingNegative then Text.Middle(T, 1, Text.Length(T) - 2) else T,
		                NoSeparators = if Unwrapped = null then null else Text.Remove(Unwrapped, {",", " ", "$", "€", "£"}),
		                UpperText = if NoSeparators = null then null else Text.Upper(NoSeparators),
		                NoCurrencyCodes = if UpperText = null then null else List.Accumulate(
		                    {"USD", "EUR", "GBP", "CAD", "AUD", "JPY", "CHF"},
		                    UpperText,
		                    (State as text, Token as text) as text => Text.Replace(State, Token, "")
		                ),
		                NumberText = if NoCurrencyCodes = null then null else Text.Select(NoCurrencyCodes, {"0".."9", "-", "+", ".", "E"}),
		                N = if NumberText = null or NumberText = "" then null else (try Number.FromText(NumberText, "en-US") otherwise null)
		            in
		                if N = null then null else if IsAccountingNegative then -Number.Abs(N) else N,
		
		    CleanPositive = (InputValue as any) as nullable number =>
		        let N = CleanNumber(InputValue)
		        in if N = null or N <= 0 then null else N,
		
		    CleanNonNegative = (InputValue as any) as nullable number =>
		        let N = CleanNumber(InputValue)
		        in if N = null or N < 0 then null else N,
		
		    CleanNonNegativeInteger = (InputValue as any) as nullable number =>
		        let N = CleanNumber(InputValue)
		        in if N = null or N < 0 or Number.RoundDown(N) <> N then null else try Int64.From(N) otherwise null,
		
		    CleanLogical = (InputValue as any) as nullable logical =>
		        let
		            T = CleanText(InputValue),
		            U = if T = null then null else Text.Upper(T)
		        in
		            if Value.Is(InputValue, type logical) then InputValue
		            else if List.Contains({"TRUE", "T", "YES", "Y", "1"}, U) then true
		            else if List.Contains({"FALSE", "F", "NO", "N", "0"}, U) then false
		            else null,
		
		    NormalizeStatus = (InputValue as any) as nullable text =>
		        let
		            T = CleanText(InputValue),
		            L = if T = null then null else Text.Lower(T)
		        in
		            if L = "successful" then "Successful"
		            else if L = "failed" then "Failed"
		            else if List.Contains({"canceled", "cancelled"}, L) then "Canceled"
		            else if L = "live" then "Live"
		            else if L = "suspended" then "Suspended"
		            else if L = "undefined" then "Undefined"
		            else null,
		
		    NormalizeSlug = (InputValue as any) as nullable text =>
		        let
		            T = CleanText(InputValue),
		            L = if T = null then null else Text.Lower(T),
		            Replaced = if L = null then null else Text.Replace(Text.Replace(L, " ", "-"), "_", "-"),
		            Collapsed = if Replaced = null then null else List.Accumulate({1..10}, Replaced, (State as text, I as number) as text => Text.Replace(State, "--", "-")),
		            Result = if Collapsed = null then null else Text.Trim(Collapsed, {"-"})
		        in
		            if Result = null or Result = "" then null else Result,
		
		    ParseDateTime = (InputValue as any) as nullable datetime =>
		        let
		            IsDateTime = Value.Is(InputValue, type datetime),
		            IsDateTimeZone = Value.Is(InputValue, type datetimezone),
		            IsDate = Value.Is(InputValue, type date),
		            T = CleanText(InputValue),
		            N = if IsDateTime or IsDateTimeZone or IsDate then null
		                else if Value.Is(InputValue, type number) then (try Number.From(InputValue) otherwise null)
		                else if T = null then null else (try Number.FromText(T, "en-US") otherwise null),
		            Parsed =
		                if InputValue = null then null
		                else if IsDateTime then DateTime.From(InputValue)
		                else if IsDateTimeZone then DateTimeZone.RemoveZone(InputValue)
		                else if IsDate then DateTime.From(InputValue)
		                else if N <> null and Number.Abs(N) >= 100000000000 then
		                    (try #datetime(1970, 1, 1, 0, 0, 0) + #duration(0, 0, 0, N / 1000) otherwise null)
		                else if N <> null and Number.Abs(N) >= 1000000000 then
		                    (try #datetime(1970, 1, 1, 0, 0, 0) + #duration(0, 0, 0, N) otherwise null)
		                else if N <> null and N >= 30000 and N <= 60000 then
		                    (try #datetime(1899, 12, 30, 0, 0, 0) + #duration(0, 0, 0, N * 86400) otherwise null)
		                else if N <> null then null
		                else if T = null then null
		                else (try DateTimeZone.RemoveZone(DateTimeZone.FromText(T)) otherwise (try DateTime.FromText(T, [Culture = "en-US"]) otherwise (try DateTime.FromText(T, [Culture = "en-GB"]) otherwise null)))
		        in
		            Parsed,
		
		    CleanHistoricalDateTime = (InputValue as any, Maximum as datetime) as nullable datetime =>
		        let D = ParseDateTime(InputValue)
		        in if D = null or D < MinValidDateTime or D > Maximum then null else D,
		
		    // ------------------------------------------------------------------
		    // 4. Clean text, status, currencies, metrics, dates, flags and geography.
		    // ------------------------------------------------------------------
		    TextColumns = {
		        "ProjectName", "Blurb", "ProjectSlug", "StateName", "Category", "Subcategory",
		        "CountryName", "CityName", "CountyName", "CurrencyCode", "CurrencySymbol", "CurrencyTrailingCode"
		    },
		    CleanedText = Table.TransformColumns(
		        WithRequiredColumns,
		        List.Transform(TextColumns, (C as text) => {C, each CleanText(_), type nullable text}),
		        null,
		        MissingField.Ignore
		    ),
		    CleanedStatus = Table.TransformColumns(CleanedText, {{"ProjectStatus", each NormalizeStatus(_), type nullable text}}),
		    CleanedSlug = Table.TransformColumns(CleanedStatus, {{"ProjectSlug", each NormalizeSlug(_), type nullable text}}),
		    CleanedCurrency = Table.TransformColumns(
		        CleanedSlug,
		        {{"CurrencyCode", each
		            let C = if _ = null then null else Text.Upper(Text.Trim(_))
		            in if C <> null and Text.Length(C) = 3 and Text.Select(C, {"A".."Z"}) = C then C else null,
		          type nullable text}}
		    ),
		
		    NumericColumns = {
		        "ProjectID", "GoalLocal", "PledgedLocal", "GoalUSD", "PledgedUSD", "ExUSD", "BackerCount",
		        "Latitude", "Longitude", "CityPopulation", "SourcePledgePerPerson", "SourceGoalAchievementPct",
		        "SourceCampaignLengthDays", "BackersPctOfPopulation", "BackersPctOfPopulationYearMonth",
		        "BackersPctOfPopulationYear", "DaysSpentMakingCampaign", "DaysInceptionToDeadline",
		        "BackersInCityYear", "BackersInCityYearMonth", "AllTimeBackersInCity", "MeanPledgeCity",
		        "MeanPledgeCityYear", "MeanPledgeCityYearMonth"
		    },
		    CleanedNumbers = Table.TransformColumns(
		        CleanedCurrency,
		        List.Transform(NumericColumns, (C as text) => {C, each CleanNumber(_), type nullable number}),
		        null,
		        MissingField.Ignore
		    ),
		    ValidatedCoreNumbers = Table.TransformColumns(
		        CleanedNumbers,
		        {
		            {"ProjectID", each let N = CleanNonNegativeInteger(_) in if N = null or N = 0 then null else N, Int64.Type},
		            {"GoalLocal", each CleanPositive(_), type nullable number},
		            {"PledgedLocal", each CleanNonNegative(_), type nullable number},
		            {"GoalUSD", each CleanPositive(_), type nullable number},
		            {"PledgedUSD", each CleanNonNegative(_), type nullable number},
		            {"ExUSD", each CleanPositive(_), type nullable number},
		            {"BackerCount", each CleanNonNegativeInteger(_), Int64.Type},
		            {"CityPopulation", each CleanNonNegativeInteger(_), Int64.Type},
		            {"SourceCampaignLengthDays", each CleanNonNegativeInteger(_), Int64.Type},
		            {"DaysSpentMakingCampaign", each CleanNonNegativeInteger(_), Int64.Type},
		            {"DaysInceptionToDeadline", each CleanNonNegativeInteger(_), Int64.Type},
		            {"BackersInCityYear", each CleanNonNegativeInteger(_), Int64.Type},
		            {"BackersInCityYearMonth", each CleanNonNegativeInteger(_), Int64.Type},
		            {"AllTimeBackersInCity", each CleanNonNegativeInteger(_), Int64.Type},
		            {"SourcePledgePerPerson", each CleanNonNegative(_), type nullable number},
		            {"SourceGoalAchievementPct", each CleanNonNegative(_), type nullable number},
		            {"BackersPctOfPopulation", each CleanNonNegative(_), type nullable number},
		            {"BackersPctOfPopulationYearMonth", each CleanNonNegative(_), type nullable number},
		            {"BackersPctOfPopulationYear", each CleanNonNegative(_), type nullable number},
		            {"MeanPledgeCity", each CleanNonNegative(_), type nullable number},
		            {"MeanPledgeCityYear", each CleanNonNegative(_), type nullable number},
		            {"MeanPledgeCityYearMonth", each CleanNonNegative(_), type nullable number},
		            {"Latitude", each let N = CleanNumber(_) in if N = null or N < -90 or N > 90 then null else N, type nullable number},
		            {"Longitude", each let N = CleanNumber(_) in if N = null or N < -180 or N > 180 then null else N, type nullable number}
		        },
		        null,
		        MissingField.Ignore
		    ),
		    CleanedFlags = Table.TransformColumns(
		        ValidatedCoreNumbers,
		        {
		            {"StaffPickFlag", each CleanLogical(_), type nullable logical},
		            {"SpotlightFlag", each CleanLogical(_), type nullable logical},
		            {"DisableCommunicationFlag", each CleanLogical(_), type nullable logical}
		        },
		        null,
		        MissingField.Ignore
		    ),
		
		    CleanedDates = Table.TransformColumns(
		        CleanedFlags,
		        {
		            {"CreatedDateTime", each CleanHistoricalDateTime(_, MaxStartDateTime), type nullable datetime},
		            {"LaunchDateTime", each CleanHistoricalDateTime(_, MaxStartDateTime), type nullable datetime},
		            {"DeadlineDateTime", each CleanHistoricalDateTime(_, MaxEndDateTime), type nullable datetime},
		            {"StateChangedDateTime", each CleanHistoricalDateTime(_, MaxEndDateTime), type nullable datetime}
		        },
		        null,
		        MissingField.Ignore
		    ),
		
		    // Drop structurally invalid campaign dates. These are not silently repaired.
		    ValidChronology = Table.SelectRows(
		        CleanedDates,
		        each [CreatedDateTime] <> null
		            and [LaunchDateTime] <> null
		            and [DeadlineDateTime] <> null
		            and [LaunchDateTime] >= [CreatedDateTime]
		            and [DeadlineDateTime] >= [LaunchDateTime]
		    ),
		
		    // Prevent half-populated coordinate pairs from being interpreted as a location.
		    AddValidLatitude = Table.AddColumn(
		        ValidChronology,
		        "__LatitudeValidated",
		        each if [Latitude] <> null and [Longitude] <> null then [Latitude] else null,
		        type nullable number
		    ),
		    AddValidLongitude = Table.AddColumn(
		        AddValidLatitude,
		        "__LongitudeValidated",
		        each if [Latitude] <> null and [Longitude] <> null then [Longitude] else null,
		        type nullable number
		    ),
		    DropOriginalCoordinates = Table.RemoveColumns(AddValidLongitude, {"Latitude", "Longitude"}),
		    RestoreCoordinates = Table.RenameColumns(
		        DropOriginalCoordinates,
		        {{"__LatitudeValidated", "Latitude"}, {"__LongitudeValidated", "Longitude"}}
		    ),
		
		    // ------------------------------------------------------------------
		    // 5. Calculate USD amounts, prioritizing source USD values.
		    // ExUSD is treated as USD per one unit of local currency, matching the
		    // convention documented in the supplied query. Confirm that convention
		    // against your source if you intend to use exchange-rate fallbacks.
		    // ------------------------------------------------------------------
		    AddGoalUSDCalc = Table.AddColumn(
		        RestoreCoordinates,
		        "__GoalUSD_Calc",
		        each
		            let
		                ExistingUSD = CleanPositive([GoalUSD]),
		                LocalGoal = CleanPositive([GoalLocal]),
		                Rate = CleanPositive([ExUSD]),
		                Converted = if LocalGoal <> null and Rate <> null then LocalGoal * Rate else null,
		                USDLocal = if [CurrencyCode] = "USD" then LocalGoal else null
		            in
		                if ExistingUSD <> null then ExistingUSD
		                else if Converted <> null and Converted > 0 then Converted
		                else USDLocal,
		        type nullable number
		    ),
		    AddPledgedUSDCalc = Table.AddColumn(
		        AddGoalUSDCalc,
		        "__PledgedUSD_Calc",
		        each
		            let
		                ExistingUSD = CleanNonNegative([PledgedUSD]),
		                LocalPledged = CleanNonNegative([PledgedLocal]),
		                Rate = CleanPositive([ExUSD]),
		                Converted = if LocalPledged <> null and Rate <> null then LocalPledged * Rate else null,
		                USDLocal = if [CurrencyCode] = "USD" then LocalPledged else null
		            in
		                if ExistingUSD <> null then ExistingUSD
		                else if Converted <> null and Converted >= 0 then Converted
		                else USDLocal,
		        type nullable number
		    ),
		    DropPriorUSD = Table.RemoveColumns(AddPledgedUSDCalc, {"GoalUSD", "PledgedUSD"}),
		    RestoreGoalUSD = Table.RenameColumns(DropPriorUSD, {{"__GoalUSD_Calc", "GoalUSD"}}),
		    RestorePledgedUSD = Table.RenameColumns(RestoreGoalUSD, {{"__PledgedUSD_Calc", "PledgedUSD"}}),
		
		    // ------------------------------------------------------------------
		    // 6. Derived reporting fields.
		    // The raw MasterKickstarter export already includes some derived calendar
		    // fields (for example CreatedTime, LaunchYear and CreatedYearMonth).
		    // Remove those source copies before recalculating them from the validated
		    // timestamps. This prevents "The field already exists in the record" errors
		    // and makes the timestamp columns the single source of truth.
		    // ------------------------------------------------------------------
		    DerivedFieldsToRebuild = {
		        "CreatedDate", "LaunchDate", "DeadlineDate", "StateChangedDate",
		        "CreatedTime", "LaunchTime", "DeadlineTime", "StateChangedTime",
		        "CreatedYear", "LaunchYear", "DeadlineYear", "StateChangedYear",
		        "CreatedYearMonth", "LaunchYearMonth", "DeadlineYearMonth", "StateChangedYearMonth",
		        "CampaignDurationDays", "GoalAchievementPct", "PledgePerBacker",
		        "GoalReachedFlag", "HasGoalUSD", "ProjectSlugDisplay"
		    },
		    ClearedDerivedFields = Table.RemoveColumns(
		        RestorePledgedUSD,
		        DerivedFieldsToRebuild,
		        MissingField.Ignore
		    ),
		    AddCreatedDate = Table.AddColumn(ClearedDerivedFields, "CreatedDate", each Date.From([CreatedDateTime]), type date),
		    AddLaunchDate = Table.AddColumn(AddCreatedDate, "LaunchDate", each Date.From([LaunchDateTime]), type date),
		    AddDeadlineDate = Table.AddColumn(AddLaunchDate, "DeadlineDate", each Date.From([DeadlineDateTime]), type date),
		    AddStateChangedDate = Table.AddColumn(AddDeadlineDate, "StateChangedDate", each if [StateChangedDateTime] = null then null else Date.From([StateChangedDateTime]), type nullable date),
		    AddCreatedTime = Table.AddColumn(AddStateChangedDate, "CreatedTime", each Time.From([CreatedDateTime]), type time),
		    AddLaunchTime = Table.AddColumn(AddCreatedTime, "LaunchTime", each Time.From([LaunchDateTime]), type time),
		    AddDeadlineTime = Table.AddColumn(AddLaunchTime, "DeadlineTime", each Time.From([DeadlineDateTime]), type time),
		    AddStateChangedTime = Table.AddColumn(AddDeadlineTime, "StateChangedTime", each if [StateChangedDateTime] = null then null else Time.From([StateChangedDateTime]), type nullable time),
		    AddCreatedYear = Table.AddColumn(AddStateChangedTime, "CreatedYear", each Date.Year([CreatedDate]), Int64.Type),
		    AddLaunchYear = Table.AddColumn(AddCreatedYear, "LaunchYear", each Date.Year([LaunchDate]), Int64.Type),
		    AddDeadlineYear = Table.AddColumn(AddLaunchYear, "DeadlineYear", each Date.Year([DeadlineDate]), Int64.Type),
		    AddStateChangedYear = Table.AddColumn(AddDeadlineYear, "StateChangedYear", each if [StateChangedDate] = null then null else Date.Year([StateChangedDate]), type nullable number),
		    AddCreatedYearMonth = Table.AddColumn(AddStateChangedYear, "CreatedYearMonth", each Date.StartOfMonth([CreatedDate]), type date),
		    AddLaunchYearMonth = Table.AddColumn(AddCreatedYearMonth, "LaunchYearMonth", each Date.StartOfMonth([LaunchDate]), type date),
		    AddDeadlineYearMonth = Table.AddColumn(AddLaunchYearMonth, "DeadlineYearMonth", each Date.StartOfMonth([DeadlineDate]), type date),
		    AddStateChangedYearMonth = Table.AddColumn(AddDeadlineYearMonth, "StateChangedYearMonth", each if [StateChangedDate] = null then null else Date.StartOfMonth([StateChangedDate]), type nullable date),
		    AddCampaignDuration = Table.AddColumn(
		        AddStateChangedYearMonth,
		        "CampaignDurationDays",
		        each let D = Duration.Days([DeadlineDate] - [LaunchDate]) in if D < 0 or D > 365 then null else D,
		        Int64.Type
		    ),
		    AddGoalAchievement = Table.AddColumn(
		        AddCampaignDuration,
		        "GoalAchievementPct",
		        each if [GoalUSD] = null or [GoalUSD] <= 0 or [PledgedUSD] = null then null else [PledgedUSD] / [GoalUSD],
		        type nullable number
		    ),
		    AddPledgePerBacker = Table.AddColumn(
		        AddGoalAchievement,
		        "PledgePerBacker",
		        each if [PledgedUSD] = null or [BackerCount] = null or [BackerCount] <= 0 then null else [PledgedUSD] / [BackerCount],
		        type nullable number
		    ),
		    AddGoalReached = Table.AddColumn(
		        AddPledgePerBacker,
		        "GoalReachedFlag",
		        each if [GoalUSD] = null or [GoalUSD] <= 0 or [PledgedUSD] = null then null else [PledgedUSD] >= [GoalUSD],
		        type nullable logical
		    ),
		    AddHasGoalUSD = Table.AddColumn(AddGoalReached, "HasGoalUSD", each [GoalUSD] <> null and [GoalUSD] > 0, type logical),
		    AddSlugDisplay = Table.AddColumn(AddHasGoalUSD, "ProjectSlugDisplay", each if [ProjectSlug] = null then null else Text.Proper(Text.Replace([ProjectSlug], "-", " ")), type nullable text),
		
		    // ------------------------------------------------------------------
		    // 7. Remove records missing essential source facts or containing invalid
		    //    core values. Optional fields are not filled with artificial values.
		    // ------------------------------------------------------------------
		    ValidCoreRows = Table.SelectRows(
		        AddSlugDisplay,
		        each [ProjectID] <> null
		            and [ProjectName] <> null
		            and [ProjectStatus] <> null
		            and [CurrencyCode] <> null
		            and [GoalLocal] <> null and [GoalLocal] > 0
		            and [PledgedLocal] <> null and [PledgedLocal] >= 0
		            and [GoalUSD] <> null and [GoalUSD] > 0
		            and [PledgedUSD] <> null and [PledgedUSD] >= 0
		            and [BackerCount] <> null
		            and not ([BackerCount] = 0 and [PledgedUSD] > 0)
		            and [CreatedDateTime] <> null
		            and [LaunchDateTime] <> null
		            and [DeadlineDateTime] <> null
		            and [CampaignDurationDays] <> null
		    ),
		
		    // Check duplicate keys using a narrow grouping table. The previous approach
		    // grouped complete nested tables and then recombined them, which is expensive
		    // for large datasets. Repeated ProjectIDs are excluded rather than selecting
		    // an arbitrary conflicting record.
		    BufferedValidRows = Table.Buffer(ValidCoreRows),
		    ProjectIDCounts = Table.Group(
		        BufferedValidRows,
		        {"ProjectID"},
		        {{"RecordCount", each Table.RowCount(_), Int64.Type}}
		    ),
		    UniqueProjectIDRows = Table.SelectRows(ProjectIDCounts, each [RecordCount] = 1),
		    UniqueProjectIDKeys = Table.RenameColumns(
		        Table.SelectColumns(UniqueProjectIDRows, {"ProjectID"}),
		        {{"ProjectID", "__UniqueProjectID"}}
		    ),
		    JoinedUniqueKeys = Table.NestedJoin(
		        BufferedValidRows, {"ProjectID"},
		        UniqueProjectIDKeys, {"__UniqueProjectID"},
		        "__UniqueKey", JoinKind.Inner
		    ),
		    UniqueProjectRows = Table.RemoveColumns(JoinedUniqueKeys, {"__UniqueKey"}),
		
		    AddSourceSystem = Table.AddColumn(UniqueProjectRows, "Source_System", each "MasterKickstarter", type text),
		    AddSnapshotDate = Table.AddColumn(AddSourceSystem, "Snapshot_Date", each SnapshotDateReference, type date),
		    AddDateQuality = Table.AddColumn(
		        AddSnapshotDate,
		        "DateQualityFlag",
		        each if [StateChangedDateTime] = null then "Core dates valid; state-change date unavailable" else "OK",
		        type text
		    ),
		    AddDataQuality = Table.AddColumn(
		        AddDateQuality,
		        "DataQualityFlag",
		        each "Core valid; optional source fields may be missing",
		        type text
		    ),
		
		    // Keep a documented, clean schema; unknown raw export columns are not loaded.
		    PreferredColumnOrder = {
		        "ProjectID", "ProjectName", "ProjectSlug", "ProjectSlugDisplay", "Blurb",
		        "Category", "Subcategory", "ProjectStatus", "StaffPickFlag", "SpotlightFlag", "DisableCommunicationFlag",
		        "CurrencyCode", "CurrencySymbol", "CurrencyTrailingCode", "GoalLocal", "PledgedLocal",
		        "GoalUSD", "PledgedUSD", "ExUSD", "BackerCount", "SourcePledgePerPerson", "SourceGoalAchievementPct",
		        "CreatedDateTime", "CreatedDate", "CreatedTime", "CreatedYearMonth", "CreatedYear",
		        "LaunchDateTime", "LaunchDate", "LaunchTime", "LaunchYearMonth", "LaunchYear",
		        "DeadlineDateTime", "DeadlineDate", "DeadlineTime", "DeadlineYearMonth", "DeadlineYear",
		        "StateChangedDateTime", "StateChangedDate", "StateChangedTime", "StateChangedYearMonth", "StateChangedYear",
		        "CampaignDurationDays", "SourceCampaignLengthDays", "DaysSpentMakingCampaign", "DaysInceptionToDeadline",
		        "CountryName", "StateName", "CountyName", "CityName", "Latitude", "Longitude", "CityPopulation",
		        "BackersPctOfPopulation", "BackersPctOfPopulationYearMonth", "BackersPctOfPopulationYear",
		        "BackersInCityYear", "BackersInCityYearMonth", "AllTimeBackersInCity",
		        "MeanPledgeCity", "MeanPledgeCityYear", "MeanPledgeCityYearMonth",
		        "GoalAchievementPct", "PledgePerBacker", "GoalReachedFlag", "HasGoalUSD",
		        "DateQualityFlag", "DataQualityFlag", "Source_System", "Snapshot_Date"
		    },
		    FinalColumns = List.Select(PreferredColumnOrder, each Table.HasColumns(AddDataQuality, _)),
		    FinalTable = Table.ReorderColumns(
		        Table.SelectColumns(AddDataQuality, FinalColumns, MissingField.Ignore),
		        FinalColumns,
		        MissingField.Ignore
		    )
		in
		    FinalTable
	lineageTag: b22bf779-8453-48dc-9c10-fa7a35694ee4
	queryGroup: 02_Staging

	annotation PBI_ResultType = Table

expression Stg_WebRobots =
		let
		    Source = Src_WebRobots_Latest,
		    #"Renamed Columns" = Table.RenameColumns(
		        Source,
		        {
		            {"project_id", "ProjectID"},
		            {"name", "ProjectName"},
		            {"state", "ProjectStatus"},
		            {"category_name", "Category"},
		            {"subcategory_name", "Subcategory"},
		            {"country", "CountryCode"},
		            {"launched_at", "LaunchDateTime"},
		            {"deadline_at", "DeadlineDateTime"},
		            {"goal_usd", "GoalUSD"},
		            {"pledged_usd", "PledgedUSD"},
		            {"backers_count", "BackerCount"}
		        }
		    ),
		    #"Proper Cased Status" = Table.TransformColumns(
		        #"Renamed Columns",
		        {{"ProjectStatus", each Text.Proper(_), type nullable text}}
		    ),
		    #"Inserted LaunchDate" = Table.AddColumn(
		        #"Proper Cased Status", "LaunchDate",
		        each DateTime.Date([LaunchDateTime]), type nullable date
		    ),
		    #"Inserted DeadlineDate" = Table.AddColumn(
		        #"Inserted LaunchDate", "DeadlineDate",
		        each DateTime.Date([DeadlineDateTime]), type nullable date
		    ),
		    #"Calculated Duration" = Table.AddColumn(
		        #"Inserted DeadlineDate", "CampaignDurationDays",
		        each Duration.Days([DeadlineDate] - [LaunchDate]), Int64.Type
		    ),
		    #"Added GoalAchievementPct" = Table.AddColumn(
		        #"Calculated Duration", "GoalAchievementPct",
		        each if [GoalUSD] = null or [GoalUSD] = 0 or [PledgedUSD] = null then null
		             else [PledgedUSD] / [GoalUSD], Percentage.Type
		    ),
		    #"Added CurrencyCode" = Table.AddColumn(
