	annotation PBI_ResultType = Table

expression Stg_Master =
		let
		    // =====================================================================
		    // Kickstarter Master — cleaned, conformed Power Query
		    // Paste into the Advanced Editor for the Stg_Master query.
		    // Source query name in the supplied mashup is Src_Master (not Src_MasterKickstarter).
		    // =====================================================================
		
		    Source = Src_Master,
		
		    // Snapshot_Date is a dataset coverage reference, not a verified file-upload date.
		    SnapshotDateReference = #date(2017, 12, 31),
		    MinValidDateTime = #datetime(2009, 1, 1, 0, 0, 0),
		    MaxStartDateTime = #datetime(2017, 12, 31, 23, 59, 59),
		    MaxEndDateTime = #datetime(2018, 12, 31, 23, 59, 59),
		
		    // ---------------------------------------------------------------------
		    // 1. Normalize headers and remove index / blank export columns.
		    // ---------------------------------------------------------------------
		    CleanedHeaders = Table.TransformColumnNames(
		        Source,
		        each Text.Trim(Text.Clean(_))
		    ),
		
		    JunkColumnNames = {
		        "", "X1", "X1_1", "X1.1", "X", "X_1", "X.1",
		        "index", "_index", "row number", "row_number", "rownumber",
		        "row_num", "rownum", "row_id", "rowid", "unnamed: 0", "unnamed: 0.1"
		    },
		
		    JunkColumns = List.Select(
		        Table.ColumnNames(CleanedHeaders),
		        (ColumnName as text) =>
		            let N = Text.Lower(Text.Trim(ColumnName))
		            in List.Contains(List.Transform(JunkColumnNames, each Text.Lower(_)), N)
		                or Text.StartsWith(N, "unnamed:")
		    ),
		
		    RemovedJunkColumns = Table.RemoveColumns(
		        CleanedHeaders,
		        JunkColumns,
		        MissingField.Ignore
		    ),
		
		    // ---------------------------------------------------------------------
		    // 2. Rename the supplied dataset's fields to consistent business names.
		    //    Source-derived metrics receive a Source prefix where a calculated
		    //    field will be produced later, avoiding duplicate/ambiguous meanings.
		    // ---------------------------------------------------------------------
		    RenameMap = {
		        {"id", "ProjectID"},
		        {"ID", "ProjectID"},
		        {"name", "ProjectName"},
		        {"Name", "ProjectName"},
		        {"blurb", "Blurb"},
		        {"slug", "ProjectSlug"},
		        {"status", "ProjectStatus"},
		        {"Status", "ProjectStatus"},
		        {"State", "StateName"},
		        {"Categories", "Category"},
		        {"category", "Subcategory"},
		        {"subcategory", "Subcategory"},
		        {"sub_category", "Subcategory"},
		        {"Country", "CountryName"},
		        {"country", "CountryName"},
		        {"City", "CityName"},
		        {"city", "CityName"},
		        {"County", "CountyName"},
		        {"county", "CountyName"},
		        {"currency", "CurrencyCode"},
		        {"Currency", "CurrencyCode"},
		        {"currency_symbol", "CurrencySymbol"},
		        {"currency_trailing_code", "CurrencyTrailingCode"},
		        {"goal", "GoalLocal"},
		        {"Goal", "GoalLocal"},
		        {"pledged", "PledgedLocal"},
		        {"Pledged", "PledgedLocal"},
		        {"pledgedUSD", "PledgedUSD"},
		        {"usd_pledged_real", "PledgedUSD"},
		        {"usd pledged", "PledgedUSD"},
		        {"usd_pledged", "PledgedUSD"},
		        {"pledged_usd", "PledgedUSD"},
		        {"usd_goal_real", "GoalUSD"},
		        {"usd goal real", "GoalUSD"},
		        {"goal_usd", "GoalUSD"},
		        {"Ex_USd", "ExUSD"},
		        {"ex_usd", "ExUSD"},
		        {"EX_USD", "ExUSD"},
		        {"exUSD", "ExUSD"},
		        {"exchange_rate_usd", "ExUSD"},
		        {"static_usd_rate", "ExUSD"},
		        {"backers_count", "BackerCount"},
		        {"backers", "BackerCount"},
		        {"Backers", "BackerCount"},
		        {"staff_pick", "StaffPickFlag"},
		        {"staffPick", "StaffPickFlag"},
		        {"spotLight", "SpotlightFlag"},
		        {"spotlight", "SpotlightFlag"},
		        {"disable_communication", "DisableCommunicationFlag"},
		        {"created_at", "CreatedDateTime"},
		        {"createdAt", "CreatedDateTime"},
		        {"created", "CreatedDateTime"},
		        {"CreatedDate", "CreatedDateTime"},
		        {"launched_at", "LaunchDateTime"},
		        {"launched", "LaunchDateTime"},
		        {"Launched", "LaunchDateTime"},
		        {"LaunchDate", "LaunchDateTime"},
		        {"deadline", "DeadlineDateTime"},
		        {"Deadline", "DeadlineDateTime"},
		        {"DeadlineDate", "DeadlineDateTime"},
		        {"state_changed_at", "StateChangedDateTime"},
		        {"latitude", "Latitude"},
		        {"longitude", "Longitude"},
		        {"City_Pop", "CityPopulation"},
		        {"city_pop", "CityPopulation"},
		        {"deadlineTime", "DeadlineTime"},
		        {"state_changed_atTime", "StateChangedTime"},
		        {"created_atTime", "CreatedTime"},
		        {"launched_atTime", "LaunchTime"},
		        {"deadlineYM", "DeadlineYearMonth"},
		        {"state_changed_atYM", "StateChangedYearMonth"},
		        {"created_atYM", "CreatedYearMonth"},
		        {"launched_atYM", "LaunchYearMonth"},
		        {"deadlineY", "DeadlineYear"},
		        {"state_changed_atY", "StateChangedYear"},
		        {"created_atY", "CreatedYear"},
		        {"launched_atY", "LaunchYear"},
		        {"Pledge_per_person", "SourcePledgePerPerson"},
		        {"Prct_goal", "SourceGoalAchievementPct"},
		        {"Length_of_kick", "SourceCampaignLengthDays"},
		        {"Backers_as_Prct_of_Pop", "BackersPctOfPopulation"},
		        {"Backers_as_Prct_of_Pop_YM", "BackersPctOfPopulationYearMonth"},
		        {"Backers_as_Prct_of_Pop_Y", "BackersPctOfPopulationYear"},
		        {"Days_spent_making_campign", "DaysSpentMakingCampaign"},
		        {"Days_inception_to_Deadline", "DaysInceptionToDeadline"},
		        {"Backers_in_city_Y", "BackersInCityYear"},
		        {"Backers_in_city_YM", "BackersInCityYearMonth"},
		        {"All_Time_Backers_city", "AllTimeBackersInCity"},
		        {"Mean_Pledge_City", "MeanPledgeCity"},
		        {"Mean_pledge_city_Y", "MeanPledgeCityYear"},
		        {"Mean_pledge_city_YM", "MeanPledgeCityYearMonth"}
		    },
		
		    RenamedCanonicalColumns = List.Accumulate(
		        RenameMap,
		        RemovedJunkColumns,
		        (CurrentTable as table, Pair as list) as table =>
		            if Table.HasColumns(CurrentTable, Pair{0})
		                and not Table.HasColumns(CurrentTable, Pair{1})
		            then Table.RenameColumns(CurrentTable, {Pair}, MissingField.Ignore)
		            else CurrentTable
		    ),
		
		    // If different source variants have both a source metric and a canonical
		    // column, don't overwrite either one. The standard source schema has only
		    // one of each such field.
		
		    // ---------------------------------------------------------------------
		    // 3. Cleaning functions. These return null instead of refresh-breaking
		    //    errors; null is retained where the source value is genuinely unknown.
		    // ---------------------------------------------------------------------
		    CleanText = (Value as any) as nullable text =>
		        let
		            T = if Value = null then null else
		                (try Text.Clean(Text.Trim(Text.From(Value, "en-US"))) otherwise null),
		            U = if T = null then null else Text.Upper(T)
		        in
		            if T = null or T = "" or List.Contains({"NA", "N/A", "NULL", "<NULL>", "NAN"}, U)
		            then null else T,
		
		    CleanNumber = (Value as any) as nullable number =>
		        if Value = null then null
		        else if Value.Is(Value, type number) then
		            (try Number.From(Value) otherwise null)
		        else
		            let
		                T = CleanText(Value),
		                IsNegativeAccounting = T <> null and Text.StartsWith(T, "(") and Text.EndsWith(T, ")"),
		                Unwrapped = if T = null then null else if IsNegativeAccounting then Text.Middle(T, 1, Text.Length(T) - 2) else T,
		                NoSeparators = if Unwrapped = null then null else Text.Remove(Unwrapped, {",", " ", "$", "€", "£"}),
		                UpperText = if NoSeparators = null then null else Text.Upper(NoSeparators),
		                NoCodes = if UpperText = null then null else List.Accumulate(
		                    {"USD", "EUR", "GBP", "CAD", "AUD", "JPY", "CHF"},
		                    UpperText,
		                    (State as text, Token as text) as text => Text.Replace(State, Token, "")
		                ),
		                NumberText = if NoCodes = null then null else Text.Select(NoCodes, {"0".."9", "-", "+", ".", "E"}),
		                N = if NumberText = null or NumberText = "" then null else (try Number.FromText(NumberText, "en-US") otherwise null)
		            in
		                if N = null then null else if IsNegativeAccounting then -Number.Abs(N) else N,
		
		    CleanNonNegative = (Value as any) as nullable number =>
		        let N = CleanNumber(Value)
		        in if N = null or N < 0 then null else N,
		
		    CleanPositive = (Value as any) as nullable number =>
		        let N = CleanNumber(Value)
		        in if N = null or N <= 0 then null else N,
		
		    CleanInteger = (Value as any) as nullable number =>
		        let N = CleanNumber(Value)
		        in if N = null or Number.RoundDown(N) <> N then null else try Int64.From(N) otherwise null,
		
		    CleanNonNegativeInteger = (Value as any) as nullable number =>
		        let N = CleanInteger(Value)
		        in if N = null or N < 0 then null else N,
		
		    CleanLogical = (Value as any) as nullable logical =>
		        let T = CleanText(Value), U = if T = null then null else Text.Upper(T)
		        in if Value.Is(Value, type logical) then Value
		           else if List.Contains({"TRUE", "T", "YES", "Y", "1"}, U) then true
		           else if List.Contains({"FALSE", "F", "NO", "N", "0"}, U) then false
		           else null,
		
		    NormalizeStatus = (Value as any) as nullable text =>
		        let T = CleanText(Value), L = if T = null then null else Text.Lower(T)
		        in if L = null then null
		           else if L = "successful" then "Successful"
		           else if L = "failed" then "Failed"
		           else if List.Contains({"canceled", "cancelled"}, L) then "Canceled"
		           else if L = "live" then "Live"
		           else if L = "suspended" then "Suspended"
		           else if L = "undefined" then "Undefined"
		           else Text.Proper(L),
		
		    NormalizeSlug = (Value as any) as nullable text =>
		        let
		            T = CleanText(Value),
		            L = if T = null then null else Text.Lower(T),
		            Replaced = if L = null then null else Text.Replace(Text.Replace(L, " ", "-"), "_", "-"),
		            Collapsed = if Replaced = null then null else List.Accumulate({1..10}, Replaced, (State as text, I as number) as text => Text.Replace(State, "--", "-")),
		            Result = if Collapsed = null then null else Text.Trim(Collapsed, {"-"})
		        in
		            if Result = "" then null else Result,
		
		    ParseDateTime = (Value as any) as nullable datetime =>
		        let
		            IsDT = Value.Is(Value, type datetime),
		            IsDTZ = Value.Is(Value, type datetimezone),
		            IsD = Value.Is(Value, type date),
		            T = CleanText(Value),
		            N = if IsDT or IsDTZ or IsD then null else if Value.Is(Value, type number) then (try Number.From(Value) otherwise null) else if T = null then null else (try Number.FromText(T, "en-US") otherwise null),
		            Parsed =
		                if Value = null then null
		                else if IsDT then DateTime.From(Value)
		                else if IsDTZ then DateTimeZone.RemoveZone(Value)
		                else if IsD then DateTime.From(Value)
		                else if N <> null and Number.Abs(N) >= 100000000000 then
		                    (try #datetime(1970, 1, 1, 0, 0, 0) + #duration(0, 0, 0, N / 1000) otherwise null)
		                else if N <> null and Number.Abs(N) >= 1000000000 then
		                    (try #datetime(1970, 1, 1, 0, 0, 0) + #duration(0, 0, 0, N) otherwise null)
		                else if N <> null and N >= 30000 and N <= 50000 then
		                    (try #datetime(1899, 12, 30, 0, 0, 0) + #duration(0, 0, 0, N * 86400) otherwise null)
		                else if N <> null then null
		                else if T = null then null
		                else (try DateTimeZone.RemoveZone(DateTimeZone.FromText(T)) otherwise (try DateTime.FromText(T, [Culture = "en-US"]) otherwise (try DateTime.FromText(T, [Culture = "en-GB"]) otherwise null)))
		        in
		            Parsed,
		
		    CleanHistoricalDateTime = (Value as any, Maximum as datetime) as nullable datetime =>
		        let D = ParseDateTime(Value)
		        in if D = null or D < MinValidDateTime or D > Maximum then null else D,
		
		    CleanTimeValue = (Value as any) as nullable time =>
		        if Value = null then null
		        else if Value.Is(Value, type time) then Time.From(Value)
		        else if Value.Is(Value, type datetime) or Value.Is(Value, type datetimezone) or Value.Is(Value, type date) then (try Time.From(Value) otherwise null)
		        else
		            let
		                T = CleanText(Value),
		                N = CleanNumber(Value),
		                Parsed = if N <> null and N >= 0 and N < 1 then (try Time.From(N) otherwise null)
		                         else if T = null then null
		                         else (try Time.FromText(T, [Culture = "en-US"]) otherwise (try Time.FromText(T, [Culture = "en-GB"]) otherwise (try Time.From(DateTime.FromText(T, [Culture = "en-US"])) otherwise null)))
		            in Parsed,
		
		    CleanYearMonth = (Value as any) as nullable date =>
		        if Value = null then null
		        else if Value.Is(Value, type date) or Value.Is(Value, type datetime) or Value.Is(Value, type datetimezone) then (try Date.StartOfMonth(Date.From(Value)) otherwise null)
		        else
		            let
		                T = CleanText(Value),
		                N = CleanNumber(Value),
		                NumericYM = if N <> null and N >= 190001 and N <= 209912 and Number.RoundDown(N) = N then let Y = Number.RoundDown(N / 100), M = Number.Mod(N, 100) in (try #date(Y, M, 1) otherwise null) else null,
		                PatternYM = if T <> null and Text.Length(T) >= 7 and List.Contains({"-", "/"}, Text.Middle(T, 4, 1)) then (try #date(Number.FromText(Text.Start(T, 4)), Number.FromText(Text.Range(T, 5, 2)), 1) otherwise null) else null,
		                ParsedDate = if T = null then null else (try Date.FromText(T, [Culture = "en-US"]) otherwise (try Date.FromText(T, [Culture = "en-GB"]) otherwise null)),
		                Candidate = if NumericYM <> null then NumericYM else if PatternYM <> null then PatternYM else if ParsedDate <> null then Date.StartOfMonth(ParsedDate) else null
		            in
		                if Candidate = null then null
		                else if Date.Year(Candidate) < 2009 or Date.Year(Candidate) > 2018 then null
		                else Date.StartOfMonth(Candidate),
		
		    CleanYearValue = (Value as any) as nullable number =>
		        if Value = null then null
		        else if Value.Is(Value, type date) or Value.Is(Value, type datetime) or Value.Is(Value, type datetimezone) then (try Date.Year(Date.From(Value)) otherwise null)
		        else
		            let
		                N = CleanNumber(Value), T = CleanText(Value),
		                ParsedDate = if T = null then null else (try Date.FromText(T, [Culture = "en-US"]) otherwise (try Date.FromText(T, [Culture = "en-GB"]) otherwise null))
		            in if N <> null and N >= 2009 and N <= 2018 and Number.RoundDown(N) = N then Int64.From(N) else if ParsedDate <> null and Date.Year(ParsedDate) >= 2009 and Date.Year(ParsedDate) <= 2018 then Date.Year(ParsedDate) else null,
		
		    // ---------------------------------------------------------------------
		    // 4. Ensure the stable core schema exists. Missing source attributes are
		    //    flagged; they are not replaced with fabricated business data.
		    // ---------------------------------------------------------------------
		    RequiredColumns = {
		        {"ProjectID", type nullable number}, {"ProjectName", type nullable text},
		        {"Blurb", type nullable text}, {"ProjectSlug", type nullable text},
		        {"Category", type nullable text}, {"Subcategory", type nullable text},
		        {"ProjectStatus", type nullable text}, {"CurrencyCode", type nullable text},
		        {"CurrencySymbol", type nullable text}, {"CurrencyTrailingCode", type nullable text},
		        {"CountryName", type nullable text}, {"CityName", type nullable text},
		        {"CountyName", type nullable text}, {"StateName", type nullable text},
		        {"GoalLocal", type nullable number}, {"PledgedLocal", type nullable number},
		        {"GoalUSD", type nullable number}, {"PledgedUSD", type nullable number},
		        {"ExUSD", type nullable number}, {"BackerCount", type nullable number},
		        {"StaffPickFlag", type nullable logical}, {"SpotlightFlag", type nullable logical},
		        {"DisableCommunicationFlag", type nullable logical},
		        {"CreatedDateTime", type nullable datetime}, {"LaunchDateTime", type nullable datetime},
		        {"DeadlineDateTime", type nullable datetime}, {"StateChangedDateTime", type nullable datetime},
		        {"Latitude", type nullable number}, {"Longitude", type nullable number},
		        {"CityPopulation", type nullable number}
		    },
		
		    WithRequiredColumns = List.Accumulate(
		        RequiredColumns,
		        RenamedCanonicalColumns,
		        (T as table, Definition as list) as table =>
		            if Table.HasColumns(T, Definition{0}) then T
		            else Table.AddColumn(T, Definition{0}, each null, Definition{1})
		    ),
		
		    // Clean source strings and preserve true missing values as null.
		    TextColumns = {
		        "ProjectName", "Blurb", "ProjectSlug", "Category", "Subcategory",
		        "CurrencyCode", "CurrencySymbol", "CurrencyTrailingCode", "CountryName",
		        "CityName", "CountyName", "StateName"
		    },
		    ExistingTextColumns = List.Intersect({TextColumns, Table.ColumnNames(WithRequiredColumns)}),
		    TextTransforms = List.Transform(ExistingTextColumns, (C as text) => {C, each CleanText(_), type nullable text}),
		    CleanedText = Table.TransformColumns(WithRequiredColumns, TextTransforms, null, MissingField.Ignore),
		
		    NormalizedStatus = Table.TransformColumns(
		        CleanedText,
		        {{"ProjectStatus", each NormalizeStatus(_), type nullable text}},
		        null,
		        MissingField.Ignore
		    ),
		    NormalizedSlug = Table.TransformColumns(
		        NormalizedStatus,
		        {{"ProjectSlug", each NormalizeSlug(_), type nullable text}},
		        null,
		        MissingField.Ignore
		    ),
		    NormalizedCurrency = Table.TransformColumns(
		        NormalizedSlug,
		        {{"CurrencyCode", each if _ = null then null else Text.Upper(Text.Trim(_)), type nullable text}},
		        null,
		        MissingField.Ignore
		    ),
		    AddedProjectSlugDisplay = Table.AddColumn(
		        NormalizedCurrency,
		        "ProjectSlugDisplay",
		        each if [ProjectSlug] = null then null else Text.Proper(Text.Replace([ProjectSlug], "-", " ")),
		        type nullable text
		    ),
		
		    // ---------------------------------------------------------------------
		    // 5. Capture original dates for diagnostics, then parse and validate them.
		    // ---------------------------------------------------------------------
		    DateColumns = {"CreatedDateTime", "LaunchDateTime", "DeadlineDateTime", "StateChangedDateTime"},
		    StoredRawDates = Table.AddColumn(
		        AddedProjectSlugDisplay,
		        "__RawDateValues",
		        each Record.SelectFields(_, DateColumns, MissingField.UseNull),
		        type record
		    ),
		    DateTransforms = {
		        {"CreatedDateTime", each CleanHistoricalDateTime(_, MaxStartDateTime), type nullable datetime},
		        {"LaunchDateTime", each CleanHistoricalDateTime(_, MaxStartDateTime), type nullable datetime},
		        {"DeadlineDateTime", each CleanHistoricalDateTime(_, MaxEndDateTime), type nullable datetime},
		        {"StateChangedDateTime", each CleanHistoricalDateTime(_, MaxEndDateTime), type nullable datetime}
		    },
		    CleanedDates = Table.TransformColumns(StoredRawDates, DateTransforms, null, MissingField.Ignore),
		
		    DateQuality = Table.AddColumn(
		        CleanedDates,
		        "DateQualityFlag",
		        each
		            let
		                CurrentRow = _,
		                R = CurrentRow[__RawDateValues],
		                InvalidDateIssues = List.RemoveNulls(List.Transform(DateColumns, (C as text) =>
		                    let Raw = Record.FieldOrDefault(R, C, null), Parsed = Record.FieldOrDefault(CurrentRow, C, null)
		                    in if CleanText(Raw) <> null and Parsed = null then "Invalid/out-of-range: " & C else null)),
		                MissingCoreDateIssues = List.RemoveNulls({
		                    if CurrentRow[CreatedDateTime] = null then "Missing/invalid: CreatedDateTime" else null,
		                    if CurrentRow[LaunchDateTime] = null then "Missing/invalid: LaunchDateTime" else null,
		                    if CurrentRow[DeadlineDateTime] = null then "Missing/invalid: DeadlineDateTime" else null
		                }),
		                ChronologyIssues = List.RemoveNulls({
		                    if CurrentRow[CreatedDateTime] <> null and CurrentRow[LaunchDateTime] <> null and CurrentRow[LaunchDateTime] < CurrentRow[CreatedDateTime] then "Launch before creation" else null,
		                    if CurrentRow[LaunchDateTime] <> null and CurrentRow[DeadlineDateTime] <> null and CurrentRow[DeadlineDateTime] < CurrentRow[LaunchDateTime] then "Deadline before launch" else null
		                }),
		                Issues = List.Combine({InvalidDateIssues, MissingCoreDateIssues, ChronologyIssues})
		            in if List.IsEmpty(Issues) then "OK" else Text.Combine(Issues, "; "),
		        type text
		    ),
		
		    ValidatedLaunch = Table.AddColumn(
		        DateQuality,
		        "__LaunchValidated",
		        each if [LaunchDateTime] <> null and [CreatedDateTime] <> null and [LaunchDateTime] < [CreatedDateTime] then null else [LaunchDateTime],
		        type nullable datetime
		    ),
		    DropLaunch = Table.RemoveColumns(ValidatedLaunch, {"LaunchDateTime"}),
		    RestoreLaunch = Table.RenameColumns(DropLaunch, {{"__LaunchValidated", "LaunchDateTime"}}),
		    ValidatedDeadline = Table.AddColumn(
		        RestoreLaunch,
		        "__DeadlineValidated",
		        each if [DeadlineDateTime] <> null and [LaunchDateTime] <> null and [DeadlineDateTime] < [LaunchDateTime] then null else [DeadlineDateTime],
		        type nullable datetime
		    ),
		    DropDeadline = Table.RemoveColumns(ValidatedDeadline, {"DeadlineDateTime"}),
		    RestoreDeadline = Table.RenameColumns(DropDeadline, {{"__DeadlineValidated", "DeadlineDateTime"}}),
		    DropRawDateRecord = Table.RemoveColumns(RestoreDeadline, {"__RawDateValues"}),
		
		    // ---------------------------------------------------------------------
		    // 6. Correct numeric, boolean, geographic and derived-feature data types.
		    // ---------------------------------------------------------------------
		    NumericCoreTransforms = {
		        {"ProjectID", each let N = CleanInteger(_) in if N = null or N <= 0 then null else N, Int64.Type},
		        {"GoalLocal", each CleanPositive(_), type nullable number},
		        {"PledgedLocal", each CleanNonNegative(_), type nullable number},
		        {"GoalUSD", each CleanPositive(_), Currency.Type},
		        {"PledgedUSD", each CleanNonNegative(_), Currency.Type},
		        {"ExUSD", each CleanPositive(_), type nullable number},
		        {"BackerCount", each CleanNonNegativeInteger(_), Int64.Type},
		        {"Latitude", each let N = CleanNumber(_) in if N = null or N < -90 or N > 90 then null else N, type nullable number},
		        {"Longitude", each let N = CleanNumber(_) in if N = null or N < -180 or N > 180 then null else N, type nullable number},
		        {"CityPopulation", each CleanNonNegativeInteger(_), Int64.Type}
		    },
		    CleanedNumericCore = Table.TransformColumns(DropRawDateRecord, NumericCoreTransforms, null, MissingField.Ignore),
		
		    BooleanTransforms = {
		        {"StaffPickFlag", each CleanLogical(_), type nullable logical},
		        {"SpotlightFlag", each CleanLogical(_), type nullable logical},
		        {"DisableCommunicationFlag", each CleanLogical(_), type nullable logical}
		    },
		    CleanedBooleans = Table.TransformColumns(CleanedNumericCore, BooleanTransforms, null, MissingField.Ignore),
		
		    // Derived calendar feature typing; YearMonth is a date set to the first day
		    // of the relevant month, so Power BI can use it for proper time intelligence.
		    TimeFeatureNames = {"DeadlineTime", "StateChangedTime", "CreatedTime", "LaunchTime"},
		    ExistingTimeFeatures = List.Intersect({TimeFeatureNames, Table.ColumnNames(CleanedBooleans)}),
		    TypedTimeFeatures = Table.TransformColumns(
		        CleanedBooleans,
		        List.Transform(ExistingTimeFeatures, (C as text) => {C, each CleanTimeValue(_), type nullable time}),
		        null,
		        MissingField.Ignore
		    ),
		
		    YearMonthFeatureNames = {
		        "DeadlineYearMonth", "StateChangedYearMonth", "CreatedYearMonth", "LaunchYearMonth"
		    },
		    ExistingYearMonthFeatures = List.Intersect({YearMonthFeatureNames, Table.ColumnNames(TypedTimeFeatures)}),
		    TypedYearMonthFeatures = Table.TransformColumns(
		        TypedTimeFeatures,
		        List.Transform(ExistingYearMonthFeatures, (C as text) => {C, each CleanYearMonth(_), type nullable date}),
		        null,
		        MissingField.Ignore
		    ),
		
		    YearFeatureNames = {
		        "DeadlineYear", "StateChangedYear", "CreatedYear", "LaunchYear"
		    },
		    ExistingYearFeatures = List.Intersect({YearFeatureNames, Table.ColumnNames(TypedYearMonthFeatures)}),
		    TypedYearFeatures = Table.TransformColumns(
		        TypedYearMonthFeatures,
		        List.Transform(ExistingYearFeatures, (C as text) => {C, each CleanYearValue(_), Int64.Type}),
		        null,
		        MissingField.Ignore
		    ),
		
		    // The source stores these metrics as numeric values. Do not apply percent
		    // formatting blindly because the source scale (0.25 vs 25) is not specified.
		    DecimalFeatureNames = {
		        "SourcePledgePerPerson", "SourceGoalAchievementPct", "BackersPctOfPopulation",
		        "BackersPctOfPopulationYear", "BackersPctOfPopulationYearMonth"
		    },
		    ExistingDecimalFeatures = List.Intersect({DecimalFeatureNames, Table.ColumnNames(TypedYearFeatures)}),
		    TypedDecimalFeatures = Table.TransformColumns(
		        TypedYearFeatures,
		        List.Transform(ExistingDecimalFeatures, (C as text) => {C, each CleanNonNegative(_), type nullable number}),
		        null,
		        MissingField.Ignore
		    ),
		
		    MeanPledgeFeatureNames = {"MeanPledgeCity", "MeanPledgeCityYear", "MeanPledgeCityYearMonth"},
		    ExistingMeanPledgeFeatures = List.Intersect({MeanPledgeFeatureNames, Table.ColumnNames(TypedDecimalFeatures)}),
		    TypedMeanPledgeFeatures = Table.TransformColumns(
		        TypedDecimalFeatures,
		        List.Transform(ExistingMeanPledgeFeatures, (C as text) => {C, each CleanNonNegative(_), type nullable number}),
		        null,
		        MissingField.Ignore
		    ),
		
		    IntegerFeatureNames = {
		        "SourceCampaignLengthDays", "DaysSpentMakingCampaign", "DaysInceptionToDeadline",
		        "BackersInCityYear", "BackersInCityYearMonth", "AllTimeBackersInCity"
		    },
		    ExistingIntegerFeatures = List.Intersect({IntegerFeatureNames, Table.ColumnNames(TypedMeanPledgeFeatures)}),
		    TypedIntegerFeatures = Table.TransformColumns(
		        TypedMeanPledgeFeatures,
		        List.Transform(ExistingIntegerFeatures, (C as text) => {C, each CleanNonNegativeInteger(_), Int64.Type}),
		        null,
		        MissingField.Ignore
		    ),
		
		    // ---------------------------------------------------------------------
		    // 7. Derive reliable dates, duration and USD amounts.
		    // ---------------------------------------------------------------------
		    AddedCreatedDate = Table.AddColumn(
		        TypedIntegerFeatures, "CreatedDate",
		        each if [CreatedDateTime] = null then null else Date.From([CreatedDateTime]), type nullable date
		    ),
		    AddedLaunchDate = Table.AddColumn(
		        AddedCreatedDate, "LaunchDate",
		        each if [LaunchDateTime] = null then null else Date.From([LaunchDateTime]), type nullable date
		    ),
		    AddedDeadlineDate = Table.AddColumn(
		        AddedLaunchDate, "DeadlineDate",
		        each if [DeadlineDateTime] = null then null else Date.From([DeadlineDateTime]), type nullable date
		    ),
		    AddedStateChangedDate = Table.AddColumn(
		        AddedDeadlineDate, "StateChangedDate",
		        each if [StateChangedDateTime] = null then null else Date.From([StateChangedDateTime]), type nullable date
		    ),
		    AddedCampaignDuration = Table.AddColumn(
		        AddedStateChangedDate, "CampaignDurationDays",
		        each if [LaunchDate] = null or [DeadlineDate] = null then null
		             else let D = Duration.Days([DeadlineDate] - [LaunchDate]) in if D < 0 or D > 365 then null else D,
		        Int64.Type
		    ),
		
		    // Prefer an existing valid USD amount; otherwise convert local amount using
		    // ExUSD (USD per one unit of local currency), or use a 1:1 USD conversion.
		    AddedGoalUSDCalc = Table.AddColumn(
		        AddedCampaignDuration, "__GoalUSD_Calc",
		        each
		            let
		                Existing = CleanPositive(Record.FieldOrDefault(_, "GoalUSD", null)),
		                Local = CleanPositive([GoalLocal]),
		                Rate = CleanPositive([ExUSD]),
		                Converted = if Local <> null and Rate <> null then Local * Rate else null,
		                USDLocal = if [CurrencyCode] = "USD" then Local else null
		            in if Existing <> null then Existing else if Converted <> null then Converted else USDLocal,
		        Currency.Type
		    ),
		    AddedPledgedUSDCalc = Table.AddColumn(
		        AddedGoalUSDCalc, "__PledgedUSD_Calc",
		        each
		            let
		                Existing = CleanNonNegative(Record.FieldOrDefault(_, "PledgedUSD", null)),
		                Local = CleanNonNegative([PledgedLocal]),
		                Rate = CleanPositive([ExUSD]),
		                Converted = if Local <> null and Rate <> null then Local * Rate else null,
		                USDLocal = if [CurrencyCode] = "USD" then Local else null
		            in if Existing <> null then Existing else if Converted <> null then Converted else USDLocal,
		        Currency.Type
		    ),
		    DropPriorUSD = Table.RemoveColumns(AddedPledgedUSDCalc, {"GoalUSD", "PledgedUSD"}, MissingField.Ignore),
		    RestoreGoalUSD = Table.RenameColumns(DropPriorUSD, {{"__GoalUSD_Calc", "GoalUSD"}}),
		    RestorePledgedUSD = Table.RenameColumns(RestoreGoalUSD, {{"__PledgedUSD_Calc", "PledgedUSD"}}),
		
		    AddedGoalAchievement = Table.AddColumn(
		        RestorePledgedUSD, "GoalAchievementPct",
		        each if [GoalUSD] = null or [GoalUSD] <= 0 or [PledgedUSD] = null then null else [PledgedUSD] / [GoalUSD],
		        Percentage.Type
		    ),
		    AddedPledgePerBacker = Table.AddColumn(
		        AddedGoalAchievement, "PledgePerBacker",
		        each if [PledgedUSD] = null or [BackerCount] = null or [BackerCount] <= 0 then null else [PledgedUSD] / [BackerCount],
		        Currency.Type
		    ),
		    AddedGoalReached = Table.AddColumn(
		        AddedPledgePerBacker, "GoalReachedFlag",
		        each if [GoalUSD] = null or [GoalUSD] <= 0 or [PledgedUSD] = null then null else [PledgedUSD] >= [GoalUSD],
		        type nullable logical
		    ),
		    AddedHasGoalUSD = Table.AddColumn(
		        AddedGoalReached, "HasGoalUSD",
		        each [GoalUSD] <> null and [GoalUSD] > 0,
		        type logical
		    ),
		
		    // ---------------------------------------------------------------------
		    // 8. Lineage and row-level quality indicators.
		    // ---------------------------------------------------------------------
		    DropPriorLineage = Table.RemoveColumns(AddedHasGoalUSD, {"Source_System", "Snapshot_Date", "SnapshotDate"}, MissingField.Ignore),
		    AddedSourceSystem = Table.AddColumn(DropPriorLineage, "Source_System", each "MasterKickstarter", type text),
		    AddedSnapshotDate = Table.AddColumn(AddedSourceSystem, "Snapshot_Date", each SnapshotDateReference, type date),
		
		    AddedDataQualityFlag = Table.AddColumn(
		        AddedSnapshotDate, "DataQualityFlag",
		        each
		            let
		                Issues = List.RemoveNulls({
		                    if [ProjectID] = null then "Missing/invalid ProjectID" else null,
		                    if [ProjectName] = null then "Missing ProjectName" else null,
		                    if [ProjectStatus] = null then "Missing ProjectStatus" else null,
		                    if [GoalLocal] = null then "Missing/invalid GoalLocal" else null,
		                    if [GoalUSD] = null then "GoalUSD unavailable" else null,
		                    if [PledgedUSD] = null then "PledgedUSD unavailable" else null,
		                    if [DateQualityFlag] <> "OK" then "Review DateQualityFlag" else null,
		                    if [Latitude] = null and [Longitude] <> null then "Latitude missing/invalid" else null,
		                    if [Longitude] = null and [Latitude] <> null then "Longitude missing/invalid" else null
		                })
		            in if List.IsEmpty(Issues) then "OK" else Text.Combine(Issues, "; "),
		        type text
		    ),
		
		    // ---------------------------------------------------------------------
		    // 9. Business-friendly final column order. Any extra source columns that
		    //    are not in this list are retained after the standard columns.
		    // ---------------------------------------------------------------------
		    PreferredColumnOrder = {
		        "ProjectID", "ProjectName", "ProjectSlug", "ProjectSlugDisplay", "Blurb",
		        "Category", "Subcategory", "ProjectStatus", "StaffPickFlag", "SpotlightFlag", "DisableCommunicationFlag",
		        "CurrencyCode", "CurrencySymbol", "CurrencyTrailingCode", "GoalLocal", "PledgedLocal",
		        "GoalUSD", "PledgedUSD", "ExUSD", "BackerCount", "SourcePledgePerPerson", "SourceGoalAchievementPct",
		        "CreatedDateTime", "CreatedDate", "CreatedTime", "CreatedYearMonth", "CreatedYear",
		        "LaunchDateTime", "LaunchDate", "LaunchTime", "LaunchYearMonth", "LaunchYear",
		        "DeadlineDateTime", "DeadlineDate", "DeadlineTime", "DeadlineYearMonth", "DeadlineYear",
		        "StateChangedDateTime", "StateChangedDate", "StateChangedTime", "StateChangedYearMonth", "StateChangedYear",
		        "CampaignDurationDays", "SourceCampaignLengthDays", "DaysSpentMakingCampaign", "DaysInceptionToDeadline",
		        "CountryName", "StateName", "CountyName", "CityName", "Latitude", "Longitude", "CityPopulation",
		        "BackersPctOfPopulation", "BackersPctOfPopulationYearMonth", "BackersPctOfPopulationYear",
		        "BackersInCityYear", "BackersInCityYearMonth", "AllTimeBackersInCity",
		        "MeanPledgeCity", "MeanPledgeCityYear", "MeanPledgeCityYearMonth",
		        "GoalAchievementPct", "PledgePerBacker", "GoalReachedFlag", "HasGoalUSD",
		        "DateQualityFlag", "DataQualityFlag", "Source_System", "Snapshot_Date"
		    },
		    ExistingPreferredColumns = List.Select(PreferredColumnOrder, each Table.HasColumns(AddedDataQualityFlag, _)),
		    RemainingColumns = List.Difference(Table.ColumnNames(AddedDataQualityFlag), ExistingPreferredColumns),
		    ReorderedColumns = Table.ReorderColumns(AddedDataQualityFlag, ExistingPreferredColumns & RemainingColumns),
		
		    // Final safety pass: these export/index columns must never reach the model.
		    FinalTable = Table.RemoveColumns(ReorderedColumns, {"X1", "X1_1", "", "Unnamed: 0", "Unnamed: 0.1"}, MissingField.Ignore)
		in
		    FinalTable
	lineageTag: b22bf779-8453-48dc-9c10-fa7a35694ee4
	queryGroup: 02_Staging

	annotation PBI_ResultType = Table

expression Stg_WebRobots =
		let
		    Source = Src_WebRobots_Latest,
		    #"Renamed Columns" = Table.RenameColumns(
		        Source,
		        {
