		            {"pledged", "PledgedLocal"},
		            {"state", "ProjectStatus"},
		            {"backers", "BackerCount"},
		            {"country", "CountryCode"},
		            {"usd pledged", "PledgedUSD_KS"},
		            {"usd_pledged_real", "PledgedUSD"},
		            {"usd_goal_real", "GoalUSD"}
